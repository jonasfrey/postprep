{
  "name": "postprep",
  "version": "0.1.0",
  "exports": "./server.ts",
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-write --allow-env=PORT,HOST,POSTPREP_DATA server.ts",
    "dev": "deno run --allow-net --allow-read --allow-write --allow-env=PORT,HOST,POSTPREP_DATA --watch server.ts",
    "test": "deno test --allow-net --allow-read --allow-write --allow-env tests/",
    "smoke": "deno run --allow-net --allow-read --allow-write --allow-run --allow-env tools/smoke.ts",
    "check": "deno check server.ts src/*.ts tests/*.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "exclude": ["data/", "tools/smoke-screenshot.png"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-window", "no-window-prefix"]
    },
    "exclude": ["data/"]
  }
}
